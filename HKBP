==+-<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HKBP Bandar Buntu - Huria Kristen Batak Protestan</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        hkbp: {
                            navy: '#0f2b5c',
                            navydark: '#0a1d40',
                            gold: '#d4af37',
                            goldlight: '#f3e5ab',
                            accent: '#1e40af'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="font-sans bg-gray-50 text-gray-800 antialiased selection:bg-hkbp-gold selection:text-hkbp-navy">

    <!-- Top Info Bar -->
    <div class="bg-hkbp-navydark text-gray-300 text-xs py-2 px-4 border-b border-hkbp-gold/20 hidden md:block">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-6">
                <span><i class="fas fa-church text-hkbp-gold mr-2"></i>Distrik V SUMATERA - TIMUR</span>
                <span><i class="fas fa-map-marker-alt text-hkbp-gold mr-2"></i>Jl. Gereja Bandar Buntu, Peragangan</span>
                <span><i class="fas fa-phone-alt text-hkbp-gold mr-2"></i>(0813-7060-0815)</span>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-hkbp-gold font-semibold">Tahun Kesehatian HKBP 2026</span>
                <div class="flex space-x-2 border-l border-gray-600 pl-4">
                    <a href="#" class="hover:text-hkbp-gold transition"><i class="fab fa-facebook"></i></a>
                    <a href="#" class="hover:text-hkbp-gold transition"><i class="fab fa-youtube"></i></a>
                    <a href="#" class="hover:text-hkbp-gold transition"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Header & Navigation -->
    <header class="sticky top-0 z-50 bg-hkbp-navy text-white shadow-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                
                <!-- Logo & Brand -->
                <a href="#beranda" class="flex items-center space-x-3 group">
                    <div class="w-12 h-12 rounded-full bg-white p-1.5 flex items-center justify-center shadow-md border-2 border-hkbp-gold group-hover:scale-105 transition-transform">
                        <!-- HKBP Logo SVG -->
                        <svg viewBox="0 0 100 100" class="w-full h-full">
                            <circle cx="50" cy="50" r="48" fill="#0f2b5c" stroke="#d4af37" stroke-width="3"/>
                            <!-- Cross -->
                            <rect x="45" y="15" width="10" height="60" fill="#ffffff" />
                            <rect x="25" y="30" width="50" height="10" fill="#ffffff" />
                            <path d="M 50 15 L 45 35 L 55 35 Z" fill="#d4af37"/>
                            <text x="50" y="88" font-family="Arial" font-weight="bold" font-size="14" fill="#ffffff" text-anchor="middle">HKBP</text>
                        </svg>
                    </div>
                    <div>
                        <span class="block text-xl font-bold tracking-tight text-white font-serif">HKBP BANDAR BUNTU</span>
                        <span class="block text-xs text-hkbp-gold tracking-widest uppercase font-medium">Huria Kristen Batak Protestan</span>
                    </div>
                </a>

                <!-- Desktop Navigation Menu -->
                <nav class="hidden lg:flex items-center space-x-1 font-medium text-sm">
                    <a href="#beranda" class="px-3 py-2 rounded-md text-white hover:text-hkbp-gold hover:bg-hkbp-navydark transition">Beranda</a>
                    <a href="#profil" class="px-3 py-2 rounded-md text-gray-200 hover:text-hkbp-gold hover:bg-hkbp-navydark transition">Profil</a>
                    <a href="#pimpinan" class="px-3 py-2 rounded-md text-gray-200 hover:text-hkbp-gold hover:bg-hkbp-navydark transition">Pimpinan</a>
                    <a href="#struktur" class="px-3 py-2 rounded-md text-gray-200 hover:text-hkbp-gold hover:bg-hkbp-navydark transition">Struktur</a>
                    <a href="#jemaat" class="px-3 py-2 rounded-md text-gray-200 hover:text-hkbp-gold hover:bg-hkbp-navydark transition">Data Jemaat</a>
                    <a href="#layanan" class="px-3 py-2 rounded-md text-gray-200 hover:text-hkbp-gold hover:bg-hkbp-navydark transition">Pelaporan & Layanan</a>
                    <a href="#kontak" class="ml-2 px-4 py-2 rounded-full bg-hkbp-gold text-hkbp-navy font-semibold hover:bg-yellow-400 transition shadow-md">Kontak</a>
                </nav>

                <!-- Mobile Menu Button -->
                <div class="lg:hidden flex items-center">
                    <button id="mobile-menu-btn" class="p-2 rounded-md text-gray-300 hover:text-white hover:bg-hkbp-navydark focus:outline-none">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu Dropdown -->
        <div id="mobile-menu" class="hidden lg:hidden bg-hkbp-navydark border-t border-hkbp-gold/20 px-4 pt-2 pb-6 space-y-2">
            <a href="#beranda" class="mobile-link block px-3 py-2 rounded-md text-base text-white hover:bg-hkbp-navy">Beranda</a>
            <a href="#profil" class="mobile-link block px-3 py-2 rounded-md text-base text-gray-300 hover:bg-hkbp-navy">Profil Gereja</a>
            <a href="#pimpinan" class="mobile-link block px-3 py-2 rounded-md text-base text-gray-300 hover:bg-hkbp-navy">Pimpinan Tahbisan</a>
            <a href="#struktur" class="mobile-link block px-3 py-2 rounded-md text-base text-gray-300 hover:bg-hkbp-navy">Struktur Organisasi</a>
            <a href="#jemaat" class="mobile-link block px-3 py-2 rounded-md text-base text-gray-300 hover:bg-hkbp-navy">Data Jemaat</a>
            <a href="#layanan" class="mobile-link block px-3 py-2 rounded-md text-base text-gray-300 hover:bg-hkbp-navy">Pelaporan & Layanan</a>
            <a href="#kontak" class="mobile-link block px-3 py-2 rounded-md text-base text-hkbp-gold font-semibold hover:bg-hkbp-navy">Kontak & Lokasi</a>
        </div>
    </header>

    <!-- SECTION 1: BERANDA (HERO & ANNOUNCEMENTS) -->
    <section id="beranda" class="relative">
        <!-- Hero Banner -->
        <div class="relative bg-hkbp-navy text-white overflow-hidden py-24 lg:py-32">
            <div class="absolute inset-0 z-0 opacity-20 bg-[radial-gradient(#d4af37_1px,transparent_1px)] [background-size:16px_16px]"></div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                        <span class="inline-block px-3 py-1 rounded-full bg-hkbp-gold/20 text-hkbp-gold border border-hkbp-gold/40 text-xs font-semibold tracking-wider uppercase">
                            Selamat Datang di HKBP Bandar Buntu Ressort Bandar Maratur
                        </span>
                        <h1 class="text-3xl sm:text-5xl font-bold font-serif leading-tight text-white">
                            Soli Deo Gloria <br>
                            <span class="text-hkbp-gold font-sans text-2xl sm:text-4xl">"Kemuliaan Hanya Bagi Allah"</span>
                        </h1>
                        <p class="text-gray-300 text-base sm:text-lg max-w-2xl font-light">
                            Menjadi gereja yang inklusif, dialogis, dan transformatif dalam memperlihatkan kasih Kristus bagi seluruh jemaat dan masyarakat.
                        </p>
                        
                        <!-- Verse Card -->
                        <div class="p-4 sm:p-6 bg-white/10 backdrop-blur-md rounded-2xl border border-white/10 shadow-inner max-w-xl mx-auto lg:mx-0">
                            <p class="text-sm sm:text-base italic font-serif text-yellow-100">
                                "J Jahowa do кай-ku, ndang hurangan au. Padao-dao do au dipatagak Dibahen do au peak di jampa na mual na tio."
                            </p>
                            <p class="text-xs sm:text-sm font-semibold text-hkbp-gold mt-2">
                                — Mazmur 23 : 1-2 (Salmo 23)
                            </p>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
                            <a href="#jadwal" class="px-6 py-3 rounded-full bg-hkbp-gold text-hkbp-navy font-bold hover:bg-yellow-400 transition shadow-lg text-center">
                                <i class="fas fa-calendar-alt mr-2"></i>Jadwal Ibadah
                            </a>
                            <a href="#layanan" class="px-6 py-3 rounded-full bg-transparent border-2 border-white text-white font-semibold hover:bg-white/10 transition text-center">
                                <i class="fas fa-file-alt mr-2"></i>Layanan Jemaat
                            </a>
                        </div>
                    </div>

                    <!-- Hero Visual Card -->
                    <div class="lg:col-span-5">
                        <div class="bg-white rounded-2xl p-6 text-gray-800 shadow-2xl border-4 border-hkbp-gold/50 relative">
                            <div class="absolute -top-4 -right-4 bg-hkbp-gold text-hkbp-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow">
                                Live Stream
                            </div>
                            <h3 class="text-xl font-bold text-hkbp-navy font-serif mb-4 flex items-center">
                                <i class="fas fa-video text-red-600 mr-2 animate-pulse"></i> Ibadah Minggu Ini
                            </h3>
                            <div class="aspect-video bg-gray-900 rounded-lg flex flex-col items-center justify-center text-white p-4 relative overflow-hidden group mb-4">
                                <img src="https://images.unsplash.com/photo-1548625361-180a9d8021c3?auto=format&fit=crop&w=800&q=80" alt="Ibadah Gereja" class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:scale-105 transition duration-500" onerror="this.src='https://placehold.co/600x400/0f2b5c/ffffff?text=Ibadah+HKBP'">
                                <div class="relative z-10 text-center">
                                    <i class="fas fa-play-circle text-5xl text-hkbp-gold mb-2 cursor-pointer hover:scale-110 transition"></i>
                                    <p class="font-bold text-sm">Minggu XXI Set. Trinitatis</p>
                                    <span class="text-xs text-gray-300">Pukul 08.00 WIB (Batam/Batak) & 10.00 WIB (Bahasa Indonesia)</span>
                                </div>
                            </div>
                            <div class="space-y-2 text-xs text-gray-600">
                                <div class="flex justify-between py-1 border-b">
                                    <span>Pengkhotbah:</span>
                                    <span class="font-semibold text-hkbp-navy">Biv.Desven Br.Panjaitan</span>
                                </div>
                                <div class="flex justify-between py-1 border-b">
                                    <span>Liturgis:</span>
                                    <span class="font-semibold text-hkbp-navy">St. R. Hutahaean</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Jadwal Ibadah Minggu & Pelayanan -->
        <div id="jadwal" class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <h2 class="text-xs font-bold uppercase tracking-widest text-hkbp-gold mb-1">Persekutuan & Ibadah</h2>
                    <p class="text-3xl font-bold font-serif text-hkbp-navy">Jadwal Ibadah & Pelayanan Kategori</p>
                    <div class="w-20 h-1 bg-hkbp-gold mx-auto mt-3 rounded-full"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Card 1: Ibadah Pagi -->
                    <div class="border border-gray-100 rounded-2xl p-6 bg-slate-50 hover:shadow-xl transition duration-300 border-l-4 border-l-hkbp-navy">
                        <div class="flex justify-between items-start mb-4">
                            <span class="p-3 bg-blue-100 text-hkbp-navy rounded-xl"><i class="fas fa-sun text-xl"></i></span>
                            <span class="text-xs font-bold uppercase bg-blue-50 text-hkbp-navy px-2.5 py-1 rounded-full">Bahasa Batak</span>
                        </div>
                        <h3 class="text-lg font-bold text-hkbp-navy mb-2">Ibadah Minggu Pagi (Pukul 10.00 WIB)</h3>
                        <p class="text-sm text-gray-600 mb-4">Ibadah Bahasa Batak umum dengan tata ibadah (Avondmaal/Agenda HKBP).</p>
                        <ul class="text-xs text-gray-500 space-y-1">
                            <li><i class="fas fa-clock mr-2 text-hkbp-gold"></i>10.00 - 11.30 WIB</li>
                            <li><i class="fas fa-map-marker-alt mr-2 text-hkbp-gold"></i>Gereja Utama</li>
                        </ul>
                    </div>

                    <!-- Card 2: Sekolah Minggu -->
                    <div class="border border-gray-100 rounded-2xl p-6 bg-slate-50 hover:shadow-xl transition duration-300 border-l-4 border-l-hkbp-gold">
                        <div class="flex justify-between items-start mb-4">
                            <span class="p-3 bg-amber-100 text-amber-800 rounded-xl"><i class="fas fa-child text-xl"></i></span>
                            <span class="text-xs font-bold uppercase bg-amber-50 text-amber-800 px-2.5 py-1 rounded-full">Sekolah Minggu</span>
                        </div>
                        <h3 class="text-lg font-bold text-hkbp-navy mb-2">Ibadah Sikola Minggu (SKM)</h3>
                        <p class="text-sm text-gray-600 mb-4">Pelayanan anak-anak usia TK hingga SD dengan puji-pujian dan cerita Alkitab.</p>
                        <ul class="text-xs text-gray-500 space-y-1">
                            <li><i class="fas fa-clock mr-2 text-hkbp-gold"></i>007.30 - 09.00 WIB</li>
                            <li><i class="fas fa-map-marker-alt mr-2 text-hkbp-gold"></i>Gereja Utama</li>
                        </ul>
                    </div>

                    <!-- Card 3: Ibadah Siang Bahasa Indonesia -->
                    <div class="border border-gray-100 rounded-2xl p-6 bg-slate-50 hover:shadow-xl transition duration-300 border-l-4 border-l-hkbp-navy">
                        <div class="flex justify-between items-start mb-4">
                            <span class="p-3 bg-indigo-100 text-indigo-800 rounded-xl"><i class="fas fa-users text-xl"></i></span>
                            <span class="text-xs font-bold uppercase bg-indigo-50 text-indigo-800 px-2.5 py-1 rounded-full">Bahasa Indonesia</span>
                        </div>
                        <h3 class="text-lg font-bold text-hkbp-navy mb-2">Ibadah Siang Umum & Remaja</h3>
                        <p class="text-sm text-gray-600 mb-4">Ibadah umum menggunakan Bahasa Indonesia.</p>
                        <ul class="text-xs text-gray-500 space-y-1">
                            <li><i class="fas fa-clock mr-2 text-hkbp-gold"></i>10.00 - 11.30 WIB (Setiap Awal BUlan)</li>
                            <li><i class="fas fa-map-marker-alt mr-2 text-hkbp-gold"></i>Gereja Utama</li>
                        </ul>
                    </div>

                    <!-- Card 4: Naposobulung (NHKBP) -->
                    <div class="border border-gray-100 rounded-2xl p-6 bg-slate-50 hover:shadow-xl transition duration-300 border-l-4 border-l-purple-600">
                        <div class="flex justify-between items-start mb-4">
                            <span class="p-3 bg-purple-100 text-purple-800 rounded-xl"><i class="fas fa-guitar text-xl"></i></span>
                            <span class="text-xs font-bold uppercase bg-purple-50 text-purple-800 px-2.5 py-1 rounded-full">NHKBP / Pemuda</span>
                        </div>
                        <h3 class="text-lg font-bold text-hkbp-navy mb-2">Ibadah Pemuda / Naposobulung</h3>
                        <p class="text-sm text-gray-600 mb-4">Wadah pemuda-pemudi HKBP bersekutu, bernyanyi, dan mendalami firman Tuhan.</p>
                        <ul class="text-xs text-gray-500 space-y-1">
                            <li><i class="fas fa-clock mr-2 text-hkbp-gold"></i>Jumat, 19.30 WIB</li>
                            <li><i class="fas fa-map-marker-alt mr-2 text-hkbp-gold"></i>Gedung Gereja Utama</li>
                        </ul>
                    </div>

                    <!-- Card 5: Ina Kamis -->
                    <div class="border border-gray-100 rounded-2xl p-6 bg-slate-50 hover:shadow-xl transition duration-300 border-l-4 border-l-teal-600">
                        <div class="flex justify-between items-start mb-4">
                            <span class="p-3 bg-teal-100 text-teal-800 rounded-xl"><i class="fas fa-heart text-xl"></i></span>
                            <span class="text-xs font-bold uppercase bg-teal-50 text-teal-800 px-2.5 py-1 rounded-full">Kategori Orangtua</span>
                        </div>
                        <h3 class="text-lg font-bold text-hkbp-navy mb-2">Seksi Parompuan</h3>
                        <p class="text-sm text-gray-600 mb-4">PA Ibu (Parompuan) serta Latihan Koor Rutin setiap minggu.</p>
                        <ul class="text-xs text-gray-500 space-y-1">
                            <li><i class="fas fa-clock mr-2 text-hkbp-gold"></i>Kamis, 19.00 WIB</li>
                            <li><i class="fas fa-map-marker-alt mr-2 text-hkbp-gold"></i>Gereja Utama</li>
                        </ul>
                    </div>

                    <!-- Card 6: Ina Estomihi -->
                    <div class="border border-gray-100 rounded-2xl p-6 bg-slate-50 hover:shadow-xl transition duration-300 border-l-4 border-l-rose-600">
                        <div class="flex justify-between items-start mb-4">
                            <span class="p-3 bg-rose-100 text-rose-800 rounded-xl"><i class="fas fa-hands-helping text-xl"></i></span>
                            <span class="text-xs font-bold uppercase bg-rose-50 text-rose-800 px-2.5 py-1 rounded-full">Lansia</span>
                        </div>
                        <h3 class="text-lg font-bold text-hkbp-navy mb-2">PA & Persekutuan Lansia serta latihan koor setiap minggu</h3>
                        <p class="text-sm text-gray-600 mb-4">Ibadah kaum ibu lanjut usia.</p>
                        <ul class="text-xs text-gray-500 space-y-1">
                            <li><i class="fas fa-clock mr-2 text-hkbp-gold"></i>Sabtu Pertama, 10.00 WIB</li>
                            <li><i class="fas fa-map-marker-alt mr-2 text-hkbp-gold"></i>Sopo Godang</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Berita & Warta Gereja -->
        <div class="py-16 bg-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
                    <div>
                        <h2 class="text-xs font-bold uppercase tracking-widest text-hkbp-gold mb-1">Informasi Terkini</h2>
                        <p class="text-3xl font-bold font-serif text-hkbp-navy">Warta & Berita Huria</p>
                    </div>
                    <a href="#" class="text-hkbp-navy font-semibold hover:text-hkbp-gold transition text-sm mt-4 md:mt-0 flex items-center">
                        Lihat Semua Warta <i class="fas fa-arrow-right ml-2 text-xs"></i>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- News Item 1 -->
                    <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300 flex flex-col">
                        <img src="https://images.unsplash.com/photo-1511649475669-e288648b2339?auto=format&fit=crop&w=600&q=80" alt="Warta 1" class="h-48 w-full object-cover" onerror="this.src='https://placehold.co/600x400/0f2b5c/ffffff?text=Warta+HKBP'">
                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-xs font-semibold text-hkbp-gold">24 Oktober 2026</span>
                                <h3 class="text-lg font-bold text-hkbp-navy mt-1 mb-2 hover:text-blue-700 cursor-pointer">Pesta Gotilon & Syukuran Pesta Panen Tahun 2026</h3>
                                <p class="text-sm text-gray-600 line-clamp-3">Pelaksanaan Pesta Gotilon Resort akan dilaksanakan dengan meriah disertai lelang makanan khas Batak dan ucapan syukur.</p>
                            </div>
                            <a href="#" class="inline-block mt-4 text-xs font-bold text-hkbp-navy uppercase tracking-wider hover:text-hkbp-gold">Baca Selengkapnya &rarr;</a>
                        </div>
                    </div>

                    <!-- News Item 2 -->
                    <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300 flex flex-col">
                        <img src="https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&w=600&q=80" alt="Warta 2" class="h-48 w-full object-cover" onerror="this.src='https://placehold.co/600x400/0f2b5c/ffffff?text=Penumpangan+Tangan'">
                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-xs font-semibold text-hkbp-gold">18 Oktober 2026</span>
                                <h3 class="text-lg font-bold text-hkbp-navy mt-1 mb-2 hover:text-blue-700 cursor-pointer">Pendaftaran Calon Naik Sidi (Parguru Malua) Periode 2026/2027</h3>
                                <p class="text-sm text-gray-600 line-clamp-3">Diberitahukan kepada seluruh jemaat yang memiliki putra/putri berusia minimal 15 tahun untuk mendaftarkan diri dalam Penelaahan Sidi.</p>
                            </div>
                            <a href="#" class="inline-block mt-4 text-xs font-bold text-hkbp-navy uppercase tracking-wider hover:text-hkbp-gold">Baca Selengkapnya &rarr;</a>
                        </div>
                    </div>

                    <!-- News Item 3 -->
                    <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300 flex flex-col">
                        <img src="https://images.unsplash.com/photo-1529070538774-1843cb3265df?auto=format&fit=crop&w=600&q=80" alt="Warta 3" class="h-48 w-full object-cover" onerror="this.src='https://placehold.co/600x400/0f2b5c/ffffff?text=Kegiatan+Sosial'">
                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-xs font-semibold text-hkbp-gold">10 Oktober 2026</span>
                                <h3 class="text-lg font-bold text-hkbp-navy mt-1 mb-2 hover:text-blue-700 cursor-pointer">Aksi Sosial Kasih Diakonia: Donor Darah & Pengobatan Gratis</h3>
                                <p class="text-sm text-gray-600 line-clamp-3">Seksi Diakonia Social menyelenggarakan kegiatan pengobatan gratis dan donor darah bekerja sama dengan PMI kota.</p>
                            </div>
                            <a href="#" class="inline-block mt-4 text-xs font-bold text-hkbp-navy uppercase tracking-wider hover:text-hkbp-gold">Baca Selengkapnya &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 2: PROFIL GEREJA -->
