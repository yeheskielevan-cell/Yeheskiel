    <script>
        // Toggle Navigation Mobile Menu
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Switch Forms for Layanan Jemaat
        function switchForm(type) {
            const tabs = document.querySelectorAll('.form-tab');
            const titleDisplay = document.getElementById('form-title-display');
            const jenisInput = document.getElementById('jenis_layanan');

            // Reset tab styles
            tabs.forEach(tab => {
                tab.classList.remove('bg-hkbp-navy', 'text-white');
                tab.classList.add('bg-gray-200', 'text-gray-700');
            });

            // Set active tab style & form info
            if (type === 'baptis') {
                document.getElementById('tab-baptis').classList.add('bg-hkbp-navy', 'text-white');
                titleDisplay.innerText = "Pendaftaran Baptis Kudus (Tardidi)";
                jenisInput.value = "Baptis Kudus";
            } else if (type === 'sidi') {
                document.getElementById('tab-sidi').classList.add('bg-hkbp-navy', 'text-white');
                titleDisplay.innerText = "Pendaftaran Naik Sidi (Parguru Malua)";
                jenisInput.value = "Naik Sidi";
            } else if (type === 'nikah') {
                document.getElementById('tab-nikah').classList.add('bg-hkbp-navy', 'text-white');
                titleDisplay.innerText = "Pendaftaran Pamasu-masuon (Pernikahan Gereja)";
                jenisInput.value = "Pernikahan";
            } else if (type === 'pindah') {
                document.getElementById('tab-pindah').classList.add('bg-hkbp-navy', 'text-white');
                titleDisplay.innerText = "Pelaporan Pindah Jemaat / Perubahan Kartu Keluarga";
                jenisInput.value = "Pindah/Data KK";
            } else if (type === 'doa') {
                document.getElementById('tab-doa').classList.add('bg-hkbp-navy', 'text-white');
                titleDisplay.innerText = "Permohonan Doa / Besuk Jemaat Sakit";
                jenisInput.value = "Permohonan Doa";
            }
        }

        // Form Submit Handler
        function handleFormSubmit(event) {
            event.preventDefault();
            const alertBox = document.getElementById('alert-box');
            
            // Show Alert Notification
            alertBox.classList.remove('hidden');
            
            // Reset form input
            document.getElementById('jemaatForm').reset();

            // Auto hide notification after 6 seconds
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 6000);
        }
    </script>
